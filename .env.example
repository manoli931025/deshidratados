# Copia este archivo a .env.local y completa los valores con los datos de tu
# proyecto de Supabase (Project Settings > API).
# .env.local está en .gitignore: nunca subas las claves reales.

REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Para el despliegue en GitHub Pages, define estos MISMO valores como secrets
# del repositorio (Settings > Secrets and variables > Actions):
#   REACT_APP_SUPABASE_URL
#   REACT_APP_SUPABASE_ANON_KEY